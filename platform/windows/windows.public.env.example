# Public placeholder-only example.
# Copy this file to private storage below <REGULAR_STORAGE_ROOT>, replace every
# angle-bracket placeholder, and never commit the populated copy.
FAST_STORAGE_ROOT=<FAST_STORAGE_ROOT>
REGULAR_STORAGE_ROOT=<REGULAR_STORAGE_ROOT>

# Every mutable stack path is constrained below one of the two managed roots.
DOCKER_DATA_ROOT=<REGULAR_STORAGE_ROOT>\Docker\wsl
DOCKER_CLI=<REGULAR_STORAGE_ROOT>\Apps\DockerDesktop\resources\bin\docker.exe
DOCKER_DESKTOP_EXE=<REGULAR_STORAGE_ROOT>\Apps\DockerDesktop\Docker Desktop.exe
DOCKER_DESKTOP_EXPECTED_VERSION=4.89.0.238018
OLLAMA_EXE=<REGULAR_STORAGE_ROOT>\Apps\Ollama\ollama.exe
OLLAMA_MODELS=<FAST_STORAGE_ROOT>\Models\Ollama
OLLAMA_SCRATCH=<FAST_STORAGE_ROOT>\Scratch\Ollama
OLLAMA_LOG_ROOT=<REGULAR_STORAGE_ROOT>\Logs\Ollama
OPEN_WEBUI_DATA=<REGULAR_STORAGE_ROOT>\OpenWebUI\data
# Candidate only: deployment remains blocked until the container-to-loopback
# path is verified without creating a broad host listener.
OPEN_WEBUI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Private Tailscale identity and URLs. These are never committed.
WINDOWS_TAILSCALE_HOST=<WINDOWS_TAILSCALE_HOST>
WINDOWS_CHAT_URL=<WINDOWS_CHAT_URL>
WINDOWS_OLLAMA_ORIGIN=<WINDOWS_OLLAMA_ORIGIN>
WINDOWS_OPENAI_BASE_URL=<WINDOWS_OPENAI_BASE_URL>
WINDOWS_DASHBOARD_URL=<WINDOWS_DASHBOARD_URL>

OLLAMA_BIND=127.0.0.1:11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_FLASH_ATTENTION=true
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_EXPECTED_VERSION=0.33.3

OPEN_WEBUI_BIND=127.0.0.1:3000
OPEN_WEBUI_SECRET_KEY=<GENERATE_AND_STORE_PRIVATELY>
# Keep false except during the controlled first-admin bootstrap window.
OPEN_WEBUI_ENABLE_SIGNUP=false
TAILSCALE_FUNNEL_ENABLED=false
